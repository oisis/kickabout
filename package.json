{
  "name": "kickabout",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build --base ./",
    "preview": "vite preview --host --base ./",
    "test": "node --test test/",
    "version": "sed -i -E \"s/^(version|appVersion): .*/\\1: $npm_package_version/\" deploy/helm/kickabout/Chart.yaml && git add deploy/helm/kickabout/Chart.yaml",
    "server": "node server/server.ts",
    "apk": "npm run build && cap sync android && cd android && ./gradlew --quiet assembleDebug assembleRelease && mkdir -p ../apk && (cp app/build/outputs/apk/release/app-release.apk ../apk/kickabout.apk 2>/dev/null || cp app/build/outputs/apk/debug/app-debug.apk ../apk/kickabout.apk)"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "ws": "^8.22.1"
  }
}
